{
  "name": "dodo-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for Dodo — the desktop pet app and its shared sprite-core package.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm start --workspace apps/dodo",
    "dev:web": "npm run dev --workspace apps/dodo-web",
    "build:web": "npm run build --workspace apps/dodo-web",
    "build:renderer": "npm run build:renderer --workspace apps/dodo",
    "dist:mac": "npm run dist:mac --workspace apps/dodo",
    "dist:win": "npm run dist:win --workspace apps/dodo",
    "dist:all": "npm run dist:all --workspace apps/dodo",
    "demo:sprite": "node apps/dodo/scripts/demo-sprite.mjs"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "uiohook-napi@1.5.5": true
  }
}
